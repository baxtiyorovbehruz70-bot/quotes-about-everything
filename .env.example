# Copy this file to ".env" for local testing. Never upload ".env" to GitHub.

# From the Neon dashboard: Connect -> copy the connection string
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456.neon.tech/neondb?sslmode=require

# The password you will type into the admin panel
ADMIN_PASSWORD=change-this-to-a-long-password

# Any long random text (used to sign the admin login cookie)
SESSION_SECRET=change-this-to-a-long-random-string

PORT=3000
